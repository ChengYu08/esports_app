# 复制为 .env.development / .env.production 并填入对应环境的真实值。
# 加载规则（@expo/env，高优先级在前）：
#   .env.{NODE_ENV}.local > .env.{NODE_ENV} > .env.local > .env
#   shell 中已有的环境变量优先于所有文件。
# 开发调试 (npx expo start) 默认加载 .env.development；
# 打包经 scripts/build_apk.cjs --env prod|test 决定 NODE_ENV。
#
# API / SSO 按平台拆分（env.ts 优先读平台变量）：
#   EXPO_PUBLIC_API_BASE_URL_IOS / EXPO_PUBLIC_API_BASE_URL_ANDROID
#   EXPO_PUBLIC_SSO_BASE_URL_IOS / EXPO_PUBLIC_SSO_BASE_URL_ANDROID

EXPO_PUBLIC_API_BASE_URL_IOS=https://djapi.example.com
EXPO_PUBLIC_SSO_BASE_URL_IOS=https://auth.example.com
EXPO_PUBLIC_API_BASE_URL_ANDROID=https://djapi.example.com
EXPO_PUBLIC_SSO_BASE_URL_ANDROID=https://auth.example.com

EXPO_PUBLIC_PROTOCOL_BASE_URL=https://djpc.example.com
EXPO_PUBLIC_ENVIRONMENT=development
# App ID 根据设备自动选择 dianjing-ios / dianjing-android。
