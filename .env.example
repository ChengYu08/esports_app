# 复制为 .env.development / .env.production 并填入对应环境的真实值。
# 加载规则（@expo/env，高优先级在前）：
#   .env.{NODE_ENV}.local > .env.{NODE_ENV} > .env.local > .env
#   shell 中已有的环境变量优先于所有文件。
# 开发调试 (npx expo start) 默认加载 .env.development；
# 打包经 scripts/build_apk.cjs --env prod|test 决定 NODE_ENV。

EXPO_PUBLIC_API_BASE_URL=https://djapi.example.com
EXPO_PUBLIC_SSO_BASE_URL=https://auth.example.com
EXPO_PUBLIC_ENVIRONMENT=development
# App ID 根据设备自动选择 dianjing-ios / dianjing-android。
# 填写 Base64(client_id:原始 client_secret)，不能只编码 secret；SDK 原样拼接 Basic 头。
EXPO_PUBLIC_SSO_IOS_CLIENT_SECRET=
EXPO_PUBLIC_SSO_ANDROID_CLIENT_SECRET=
EXPO_PUBLIC_ALIYUN_IOS_AUTH_KEY=
EXPO_PUBLIC_ALIYUN_ANDROID_AUTH_KEY=
EXPO_PUBLIC_RONGCLOUD_APP_KEY=
EXPO_PUBLIC_AGORA_APP_ID=
