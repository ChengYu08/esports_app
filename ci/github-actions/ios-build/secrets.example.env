# GitHub Actions secrets template for .github/workflows/ios-build.yml
# Put real files under:
# - ci/github-actions/ios-build/signing/certs/ios_distribution.p12
# - ci/github-actions/ios-build/signing/profiles/app_store.mobileprovision
# Then run:
#   ./ci/github-actions/ios-build/signing/scripts/print-secrets.sh
#
# This file can contain real secrets after running print-secrets.sh.
# Do not commit filled values.

IOS_DISTRIBUTION_CERTIFICATE_
IOS_DISTRIBUTION_CERTIFICATE_PASSWORD=123456789
IOS_PROVISION_PROFILE_
IOS_KEYCHAIN_PASSWORD=WW53Vl3y1rZrra+MZgcda1QP/+XtaVTS
