{
  "expo": {
    "name": "盼之电竞",
    "slug": "esportsapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "esportsapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.esportsapp.apps",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-screen.png",
          "resizeMode": "cover",
          "backgroundColor": "#2A1013",
          "enableFullScreenImage_legacy": true,
          "android": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "cover",
            "imageWidth": 288
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许盼之电竞使用麦克风，用于语聊房语音交流。",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "./plugins/withNodeCommandUtf8",
      "./plugins/withAndroidReleaseBuild",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许盼之电竞访问你的照片，用于发送聊天图片。",
          "cameraPermission": false
        }
      ],
      "./plugins/withVoiceRoomBackground"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15231eb2-10b1-46ea-981b-67ec5fb980c5"
      }
    },
    "owner": "chengyu08s-team",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.esportsapp.apps",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSMicrophoneUsageDescription": "用于在语聊房中进行语音交流。"
      }
    },
    "icon": "./assets/images/icon.png"
  }
}
