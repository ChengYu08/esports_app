{
  "expo": {
    "name": "esports_app",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "esportsapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.chengyu08.app"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15231eb2-10b1-46ea-981b-67ec5fb980c5"
      }
    },
    "owner": "chengyu08s-team",
    "ios": {
      "bundleIdentifier": "com.chengyu08.app"
    }
  }
}
