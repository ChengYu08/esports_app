{
  "name": "esportsappapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-update"
        ]
      }
    }
  },
  "dependencies": {
    "@esports/sso-sdk": "*",
    "@expo/ui": "~57.0.19",
    "@fluentui/react-native-icons": "^2.0.343",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@rongcloud/react-native-im-wrapper": "^5.34.0",
    "@tanstack/react-query": "^5.103.2",
    "@types/crypto-js": "^4.2.2",
    "axios": "^1.20.0",
    "crypto-js": "^4.1.1",
    "expo": "~57.0.24",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-iap": "^6.3.0",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-agora": "4.6.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-root-toast": "^4.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-update": "^10.62.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "rn-emoji-keyboard": "^1.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "start": "node scripts/with-env.cjs test expo start",
    "start:test": "node scripts/with-env.cjs test expo start",
    "start:prod": "node scripts/with-env.cjs prod expo start",
    "start:prod-only": "node scripts/with-env.cjs prod expo start --localhost",
    "android": "node scripts/with-env.cjs test expo run:android --device",
    "android:test": "node scripts/with-env.cjs test expo run:android --device",
    "android:prod": "node scripts/with-env.cjs prod expo run:android --device",
    "ios": "node scripts/with-env.cjs test expo run:ios --device --no-bundler",
    "ios:start": "node scripts/with-env.cjs test expo start --dev-client",
    "ios:test": "node scripts/with-env.cjs test expo run:ios --device --no-bundler",
    "ios:prod": "node scripts/with-env.cjs prod expo run:ios --device",
    "web": "expo start --web",
    "lint": "expo lint",
    "prebuild": "expo prebuild",
    "build:apk": "node scripts/build_apk.cjs --env prod --abi arm64",
    "build:apk:arm64": "node scripts/build_apk.cjs --env prod --abi arm64",
    "build:apk:universal": "node scripts/build_apk.cjs --env prod --abi universal",
    "build:apk:all": "node scripts/build_apk.cjs --env prod --abi all",
    "build:apk:init-signing": "node scripts/build_apk.cjs --init-signing",
    "build:apk:test": "node scripts/build_apk.cjs --env test --abi arm64",
    "build:apk:test:universal": "node scripts/build_apk.cjs --env test --abi universal",
    "build:apk:prod": "node scripts/build_apk.cjs --abi arm64"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
